{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["total", "products"],
  "properties": {
    "total": { "type": "integer", "const": 503 },
    "products": {
      "type": "array",
      "minItems": 503,
      "maxItems": 503,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "category",
          "categories",
          "image",
          "images",
          "videos",
          "price",
          "currency",
          "description",
          "sizes",
          "stock",
          "sourceUrl",
          "needsReview"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "categories": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "image": { "type": ["string", "null"] },
          "images": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "videos": { "type": "array", "items": { "type": "string" } },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "stock": { "type": "integer", "minimum": 0 },
          "currency": { "const": "BDT" },
          "description": { "type": "string", "minLength": 1 },
          "sizes": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "candidateSizes": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "needsReview": { "type": "boolean" },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "priceSource": { "enum": ["DEMO_ESTIMATE", "SOURCE"] },
          "stockSource": { "enum": ["DEMO_ESTIMATE", "SOURCE"] },
          "requiresPriceVerification": { "type": "boolean" },
          "requiresStockVerification": { "type": "boolean" },
          "requiresSizeVerification": { "type": "boolean" },
          "requiresDescriptionReview": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "required": ["priceSource"],
              "properties": { "priceSource": { "const": "DEMO_ESTIMATE" } }
            },
            "then": {
              "required": ["requiresPriceVerification"],
              "properties": { "requiresPriceVerification": { "const": true } }
            }
          },
          {
            "if": {
              "required": ["stockSource"],
              "properties": { "stockSource": { "const": "DEMO_ESTIMATE" } }
            },
            "then": {
              "required": ["requiresStockVerification"],
              "properties": {
                "stock": { "minimum": 20, "maximum": 100 },
                "requiresStockVerification": { "const": true }
              }
            }
          }
        ]
      }
    }
  }
}
